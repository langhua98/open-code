{
  "$schema": "https://opencode.ai/config.json",
  "model": "deepseek/deepseek-v4-pro",
  "small_model": "deepseek/deepseek-flash",
  "disabled_providers": ["github-copilot"],
  "plugin": ["superpowers@git+https://github.com/obra/superpowers.git#v6.4.2"],
  "mcp": {
    "playwright": {
      "type": "local",
      "command": ["playwright-mcp", "--headless", "--browser", "chromium"],
      "timeout": 20000
    }
  },
  "permission": {
    "playwright_*": "deny"
  },
  "agent": {
    "browser": {
      "description": "Uses the Playwright browser to open and operate web pages: clicking, filling forms, logging in, pages that need JavaScript, screenshots. Use it for any step that needs a real browser; for just reading an article or docs page, use webfetch instead.",
      "mode": "all",
      "permission": {
        "playwright_*": "allow"
      }
    }
  },
  "watcher": {
    "ignore": ["runs/**", "outputs/**", ".playwright-mcp/**"]
  }
}
