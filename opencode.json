{
  "$schema": "https://opencode.ai/config.json",
  "model": "deepseek/deepseek-v4-pro",
  "small_model": "deepseek/deepseek-flash",
  "disabled_providers": ["github-copilot"],
  "provider": {
    "mac": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Mac 本地模型",
      "options": {
        "baseURL": "http://127.0.0.1:7860/mac/v1",
        "apiKey": "{env:LOCAL_LLM_API_KEY}",
        "headers": { "X-Offline-Notice": "1", "ngrok-skip-browser-warning": "1" }
      },
      "models": {
        "qwen3.5:9b": {
          "name": "Qwen3.5 9B（Mac 本地）",
          "limit": { "context": 65536, "output": 8192 },
          "options": { "reasoningEffort": "none" }
        }
      }
    },
    "nvidia": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "英伟达免费模型",
      "options": {
        "baseURL": "https://integrate.api.nvidia.com/v1",
        "apiKey": "{env:NVIDIA_API_KEY}"
      },
      "whitelist": [
        "z-ai/glm-5.3-flash",
        "deepseek-ai/deepseek-v4.1-flash",
        "minimaxai/minimax-m3.1-flash",
        "nvidia/nemotron-3-ultra-550b-a55b",
        "stepfun-ai/step-5-preview",
        "openai/gpt-oss-20b"
      ],
      "models": {
        "z-ai/glm-5.3-flash": { "name": "GLM-5.3 Flash（英伟达免费）", "limit": { "context": 200000, "output": 32768 } },
        "deepseek-ai/deepseek-v4.1-flash": { "name": "DeepSeek V4.1 Flash（英伟达免费）", "limit": { "context": 1000000, "output": 32768 } },
        "minimaxai/minimax-m3.1-flash": { "name": "MiniMax M3.1 Flash（英伟达免费）", "limit": { "context": 262144, "output": 32768 } },
        "nvidia/nemotron-3-ultra-550b-a55b": { "name": "Nemotron 3 Ultra（英伟达免费）", "limit": { "context": 1000000, "output": 65536 } },
        "stepfun-ai/step-5-preview": { "name": "Step 5 Preview（英伟达免费）", "limit": { "context": 1048576, "output": 32768 } },
        "openai/gpt-oss-20b": { "name": "gpt-oss 20B（英伟达免费）", "limit": { "context": 131072, "output": 32768 } }
      }
    }
  },
  "plugin": ["superpowers@git+https://github.com/obra/superpowers.git#v6.4.2"],
  "mcp": {
    "playwright": {
      "type": "local",
      "command": ["playwright-mcp", "--headless", "--browser", "chromium"],
      "timeout": 20000
    }
  },
  "permission": {
    "playwright_*": "deny"
  },
  "agent": {
    "browser": {
      "description": "Uses the Playwright browser to open and operate web pages: clicking, filling forms, logging in, pages that need JavaScript, screenshots. Use it for any step that needs a real browser; for just reading an article or docs page, use webfetch instead.",
      "mode": "all",
      "permission": {
        "playwright_*": "allow"
      }
    }
  },
  "watcher": {
    "ignore": ["runs/**", "outputs/**", ".playwright-mcp/**"]
  }
}
