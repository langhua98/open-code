{
  "name": "open-code: OpenCode + Kaggle GPU",
  "build": { "dockerfile": "Dockerfile" },
  "features": {
    "ghcr.io/devcontainers/features/node:1": { "version": "lts" },
    // Docker inside the codespace. An existing codespace gets it after "Rebuild Container".
    "ghcr.io/devcontainers/features/docker-in-docker:2": {}
  },
  // Installs OpenCode, its tools (browser, gh, document libraries) and the Kaggle CLI once.
  // Each time the editor connects, tools/web serves the OpenCode web UI in the foreground of a
  // terminal (a background process from postStartCommand does not survive in Codespaces).
  "postCreateCommand": "bash .devcontainer/setup.sh",
  "postAttachCommand": "bash tools/web",
  "forwardPorts": [4096],
  "portsAttributes": {
    "4096": { "label": "OpenCode Web", "onAutoForward": "notify" }
  },
  "remoteEnv": {
    "PATH": "${containerWorkspaceFolder}/tools:${containerEnv:PATH}",
    // Superpowers: don't load its logo from the author's site (version ping) in the brainstorming visual companion.
    "SUPERPOWERS_DISABLE_TELEMETRY": "1"
  },
  // Codespaces asks for these when creating a codespace and injects them as environment variables.
  "secrets": {
    "KAGGLE_API_TOKEN": {
      "description": "Kaggle API token (starts with KGAT_), used by tools/kgpu to run jobs on Kaggle GPUs.",
      "documentationUrl": "https://www.kaggle.com/settings/api"
    },
    "OPENCODE_SERVER_PASSWORD": {
      "description": "Optional password for the OpenCode web UI on port 4096 (username: opencode)."
    }
  },
  "customizations": {
    "codespaces": {
      "openFiles": ["README.md"],
      // The codespace's own GitHub token only covers this repository; also let it read and push
      // the private video project. Codespaces asks you to approve this when it is created or rebuilt.
      "repositories": {
        "langhua98/xiaoju-video": { "permissions": { "contents": "write" } }
      }
    },
    "vscode": { "extensions": ["ms-python.python"] }
  }
}
