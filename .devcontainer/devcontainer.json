{
  "name": "open-code: OpenCode + Kaggle GPU",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/node:1": { "version": "lts" }
  },
  // Installs OpenCode and the Kaggle CLI once, then serves the OpenCode web UI on every start.
  "postCreateCommand": "bash .devcontainer/setup.sh",
  "postStartCommand": "bash .devcontainer/start-opencode.sh",
  "forwardPorts": [4096],
  "portsAttributes": {
    "4096": { "label": "OpenCode Web", "onAutoForward": "notify" }
  },
  "remoteEnv": {
    "PATH": "${containerWorkspaceFolder}/tools:${containerEnv:PATH}"
  },
  // Codespaces asks for these when creating a codespace and injects them as environment variables.
  "secrets": {
    "KAGGLE_API_TOKEN": {
      "description": "Kaggle API token (starts with KGAT_), used by tools/kgpu to run jobs on Kaggle GPUs.",
      "documentationUrl": "https://www.kaggle.com/settings/api"
    },
    "OPENCODE_SERVER_PASSWORD": {
      "description": "Optional password for the OpenCode web UI on port 4096 (username: opencode)."
    }
  },
  "customizations": {
    "codespaces": { "openFiles": ["README.md"] },
    "vscode": { "extensions": ["ms-python.python"] }
  }
}
